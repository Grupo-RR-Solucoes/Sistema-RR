# regra de negócio canônica.
/auditorias/
/producao/
/stress_test_workspace_local/*
!/stress_test_workspace_local/gap_analysis.md
/.claude/

# Supabase CLI local cache
supabase/.temp/

# Brand: arquivos de diagnostico/comparacao gerados por scripts (nao
# versionar — sao saidas auxiliares). PNGs/WebPs canonicos da logo
# (logo-rr-cred-*.{png,webp}) ficam versionados.
public/brand/_*.png

# Dados sensíveis Promotiva / fechamentos (não versionar)
_tmp_fechamentos/
*.xlsx
*.xls
# Backups e cache
*.bak_*
*.bak-*
# Exports CSV pontuais de dado/diagnostico na raiz (orfas_*, etc.)
/orfas_*.csv
__pycache__/
scripts/__pycache__/
# Backups de dados gerados antes de DELETE/migração (não versionar)
scripts/_backup_*.json
# Scripts temporários de teste/validação (não versionar)
scripts/_tmp_*
