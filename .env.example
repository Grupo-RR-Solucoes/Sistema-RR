NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL base do app — usada para montar o redirectTo dos links de convite/reset
# de senha (Supabase Auth + Resend). Local: http://localhost:3000.
# Produção (Vercel): https://sistema-rr-gamma.vercel.app
# Se ausente, o código cai para o origin da request.
NEXT_PUBLIC_SITE_URL=

# Administrador principal — unica conta autorizada a EXCLUIR (delete fisico)
# usuarios em /admin/usuarios. Server-only (sem prefixo NEXT_PUBLIC_): nunca
# vai para o browser. Preencha com o e-mail exato do dono (case-insensitive).
# Fail-safe: se ficar vazia, NINGUEM pode excluir (nem socio) — so Desativar.
SUPER_ADMIN_EMAIL=
